# OPTIONAL host-side file, only for run_backup.sh failure-alert emails.
#
# The app itself gets ALL its config from the Portainer stack Environment
# variables (see the README) — there is no app.env for the containers. This file
# exists purely so the backup cron script (run_backup.sh, which runs on the host,
# not in a container) can read SMTP creds to email you when a backup fails.
#
# Only create it if you want those email alerts. Copy to ${DATA_ROOT}/app.env and
# fill in. Without it, backup failures are still logged to
# ${DATA_ROOT}/logs/backup.log — you just won't get an email.

EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Where backup-failure alerts are sent.
BACKUP_PUSH_NOTIFY_EMAIL=
